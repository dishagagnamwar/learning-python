   "source": [
    "#armstrong number \n",
    "def arm (start,stop):\n",
    "    l=[]\n",
    "    for i in range (start,stop+1):\n",
    "        a=len(str(i))\n",
    "        sm=0\n",
    "        old=i\n",
    "        while i!=0:\n",
    "            dig=i%10\n",
    "            sm=sm+(dig**a)\n",
    "            i=i//10\n",
    "        if sm==old:\n",
    "            l.append(old)\n",
    "\n",
    "    return l"
   ]
