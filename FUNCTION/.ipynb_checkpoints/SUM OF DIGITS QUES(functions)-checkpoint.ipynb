   "source": [
    "#11 sum of digits \n",
    "# n=12345%10= 5 sum=sum+5   sum=5   n=12345//10=1234\n",
    "\n",
    "def sum_num(n):\n",
    "    if n==0:\n",
    "        return 0\n",
    "    else:\n",
    "        s=0\n",
    "        temp=n\n",
    "        while temp>0:\n",
    "            digit=n%10\n",
    "            s=s+digit \n",
    "            n=n//10\n",
    "    return s\n",
    "\n",
    "print(sum_num(12345))"
   ]
