   ],
   "source": [
    "year=int(input(\"enter year\"))\n",
    "if year%4==0:\n",
    "    if year%100==0:\n",
    "        if year%400!=0:\n",
    "            print(\"leap year\")\n",
    "        else:\n",
    "            print(\"not leap year\")\n",
    "    else:\n",
    "        print(\"leap year\")\n",
    "else:\n",
    "    print(\"not leap year\")"
   ]
