    "#fabonacci series\n",
    "term=int(input(\"enter range\"))\n",
    "if term<=0:\n",
    "    print(\"enter range >0\")\n",
    "else:\n",
    "    a=0\n",
    "    b=1\n",
    "for i in range(term):\n",
    "    print(a,end=\" \")\n",
    "    c=a+b\n",
    "    a=b\n",
    "    b=c"
   ]
